{
    "// Django Core Settings": "==========================================",
    "secret_key": "REPLACE_WITH_YOUR_SECRET_KEY",
    "debug": true,
    "// Domain & Hosting Settings": "=====================================",
    "domain": "example.com",
    "domain_host": "https://example.com",
    "allowed_hosts": [
        "*"
    ],
    "// Security Settings": "=============================================",
    "csrf_trusted_origins": [
        "https://example.com",
        "http://localhost:8000",
        "http://127.0.0.1:8000"
    ],
    "trusted_orgins": [
        "*"
    ],
    "// Email Configuration": "===========================================",
    "server_mail": "admin@example.com",
    "smtp_server": "smtp.example.com",
    "port": 587,
    "sender_email": "admin@example.com",
    "password": "password",
    "feedback_email": "admin@example.com",
    "imap_server": "imap.example.com",
    "imap_port": 993,
    "imap_use_ssl": true,
    "// Admin Configuration": "===========================================",
    "admins": [
        [
            "Example Mail",
            "admin@example.com"
        ]
    ],
    "// Optional (production)": "========================================",
    "// db_name / db_user / db_password / db_host / db_port": "PostgreSQL instead of SQLite (db_engine: other Django backend)",
    "// log_file": "error log + 2FA log e.g. /var/log/django/error.log (directory writable by the app user)",
    "// trusted_proxy_count": "reverse proxies appending X-Forwarded-For (default: 1 without debug)",
    "// cache_redis_url": "default redis://127.0.0.1:6379/1",
    "// mfa_trusted_networks": "networks where admins skip the second factor e.g. 192.0.2.0/24",
    "// Push Notification Settings": "=====================================",
    "vapid_public_key": "YOUR_VAPID_PUBLIC_KEY",
    "vapid_private_key": "YOUR_VAPID_PRIVATE_KEY"
}